# MongoDB — required
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=chess
GOOGLE_CLIENT_ID=
PORT=3000
SERVER_ID=server-1

# Redis/Valkey. Single node:
REDIS_URL=redis://127.0.0.1:6379
# Or shard game state across multiple nodes (comma-separated). When set, this
# takes precedence over REDIS_URL. The first node is the coordination node
# (move stream, known_servers, heartbeats); game state is hashed across all.
# REDIS_URLS=rediss://node0:25061,rediss://node1:25061,rediss://node2:25061,rediss://node3:25061,rediss://node4:25061